rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidMemoryItem(item) {
      return item is map
        && item.keys().hasAll(['id', 'caption', 'dateLabel', 'presetArt', 'imageData'])
        && item.keys().hasOnly(['id', 'caption', 'dateLabel', 'presetArt', 'imageData'])
        && item.id is string && item.id.size() >= 1 && item.id.size() <= 64
        && item.caption is string && item.caption.size() >= 1 && item.caption.size() <= 120
        && item.dateLabel is string && item.dateLabel.size() <= 40
        && item.presetArt is string && item.presetArt in ['cake', 'sunset', 'coffee', 'stars', 'custom']
        && item.imageData is string && item.imageData.size() <= 180000;
    }

    function isValidGift(data, giftId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'recipientName', 'senderName',
          'passcodeHash', 'passcodeHint', 'envelopeTitle', 'menuTitle',
          'letterTitle', 'letterBody', 'flowerCompliments', 'memories',
          'musicTitle', 'musicSource', 'musicUrl', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'recipientName', 'senderName',
          'passcodeHash', 'passcodeHint', 'envelopeTitle', 'menuTitle',
          'letterTitle', 'letterBody', 'flowerCompliments', 'memories',
          'musicTitle', 'musicSource', 'musicUrl', 'messagePhotos', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == giftId && isValidId(data.id)
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 80
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.passcodeHash is string && data.passcodeHash.size() == 64 && data.passcodeHash.matches('^[a-f0-9]{64}$')
        && data.passcodeHint is string && data.passcodeHint.size() <= 120
        && data.envelopeTitle is string && data.envelopeTitle.size() >= 1 && data.envelopeTitle.size() <= 80
        && data.menuTitle is string && data.menuTitle.size() >= 1 && data.menuTitle.size() <= 80
        && data.letterTitle is string && data.letterTitle.size() >= 1 && data.letterTitle.size() <= 80
        && data.letterBody is string && data.letterBody.size() >= 1 && data.letterBody.size() <= 3000
        && data.flowerCompliments is list
        && data.flowerCompliments.size() >= 1 && data.flowerCompliments.size() <= 6
        && data.flowerCompliments[0] is string
        && data.flowerCompliments[0].size() >= 1 && data.flowerCompliments[0].size() <= 120
        && data.memories is list
        && data.memories.size() >= 1 && data.memories.size() <= 6
        && isValidMemoryItem(data.memories[0])
        && (!('messagePhotos' in data) || (data.messagePhotos is list && data.messagePhotos.size() <= 6))
        && data.musicTitle is string && data.musicTitle.size() >= 1 && data.musicTitle.size() <= 100
        && data.musicSource is string && data.musicSource in ['melody', 'custom_url']
        && data.musicUrl is string && data.musicUrl.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /gifts/{giftId} {
      // Single-document read by giftId allows recipients to open shared gift links
      // without exposing PII or allowing collection enumeration.
      allow get: if isValidId(giftId);

      // Creators can list only their own gifts.
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(giftId)
        && isValidGift(incoming(), giftId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(giftId)
        && isValidGift(incoming(), giftId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'recipientName', 'senderName', 'passcodeHash', 'passcodeHint',
          'envelopeTitle', 'menuTitle', 'letterTitle', 'letterBody',
          'flowerCompliments', 'memories', 'musicTitle', 'musicSource',
          'musicUrl', 'messagePhotos', 'updatedAt'
        ]);

      allow delete: if isSignedIn()
        && isValidId(giftId)
        && existing().ownerId == request.auth.uid;
    }
  }
}
